# Required
EDITOR_API_KEY=change-me-to-a-secret   # Secret key for editor agent endpoints
OWS_WALLET_NAME=agentpress-treasury    # OWS wallet name for platform

# Turso Database (required)
TURSO_DATABASE_URL=                     # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=                       # turso db tokens create <db-name>

# x402 (required for paid editions)
TREASURY_ADDRESS=                       # Platform OWS wallet address (EVM)
X402_FACILITATOR_URL=https://facilitator.payai.network  # x402 facilitator (Base mainnet)
X402_NETWORK=eip155:8453                # Base mainnet (eip155:84532 for Base Sepolia)
CRON_SECRET=                            # Vercel cron auth for Herald's daily run

# Optional
RESEND_API_KEY=                         # For email delivery (free tier: 100/day)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Herald (AI fact-checking editor; pays for its own inference via x402 from the treasury wallet)
TREASURY_PRIVATE_KEY=                   # 0x-prefixed EVM key of the newsroom wallet on Base. Never commit.
HERALD_MODEL=google/gemini-3.1-flash-lite-preview  # ~$0.001 per check via glim.sh x402
HERALD_MAX_ATOMIC=30000                 # Max USDC atomic units Herald pays per inference call (30000 = $0.03)
